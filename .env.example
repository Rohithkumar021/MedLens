# Application Configuration
APP_NAME=MedLens
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Persistence (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./medlens.db

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,txt,json
UPLOAD_DIR=./uploads

# Security & CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# AI Provider Configuration (optional: falls back seamlessly to deterministic summary if unset)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

